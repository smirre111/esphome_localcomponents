# Template for secrets.yaml — copy to secrets.yaml and fill in real values.
# secrets.yaml itself is gitignored and must never be committed.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"
esphome_ota_password: "your-ota-password"

# ESPHome native API encryption key — must be base64 of exactly 32 random
# bytes. Generate with: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "REPLACE_WITH_32_RANDOM_BYTES_BASE64"
web_server_username: "your-web-server-username"
web_server_password: "your-web-server-password"
wifi_ap_password: "your-fallback-ap-password"

# The shared LoRa fleet AES key seed. MUST match BLINDS_LORA_FLEET_KEY
# compiled into both nodes — this is a coordinated rotation, not something
# to change on only one side. Defaults to "LoRaHome" if left unset here.
lora_fleet_key: "your-lora-fleet-key"
